<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.8</version>
        <relativePath/>
    </parent>
    <groupId>com.kirtivispute</groupId>
    <artifactId>physio-portal</artifactId>
    <version>1.0.0</version>
    <name>physio-portal</name>
    <url>https://github.com/kirti-vispute/physiotherapy-appointment-portal</url>
    <description>Physiotherapy Appointment Portal college DevOps project</description>
    <properties>
        <java.version>21</java.version>
        <selenium.version>4.49.0</selenium.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-java</artifactId>
            <version>${selenium.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>selenium</id>
            <properties>
                <selenium.baseUrl>http://localhost:8082</selenium.baseUrl>
                <selenium.headless>true</selenium.headless>
                <selenium.reportsDirectory>${project.build.directory}/failsafe-reports</selenium.reportsDirectory>
                <skipUnitTests>false</skipUnitTests>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration><skipTests>${skipUnitTests}</skipTests></configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <version>3.5.6</version>
                        <configuration>
                            <includes><include>**/PortalSeleniumIT.java</include></includes>
                            <failIfNoTests>true</failIfNoTests>
                            <reportsDirectory>${selenium.reportsDirectory}</reportsDirectory>
                            <summaryFile>${selenium.reportsDirectory}/failsafe-summary.xml</summaryFile>
                            <systemPropertyVariables>
                                <selenium.baseUrl>${selenium.baseUrl}</selenium.baseUrl>
                                <selenium.headless>${selenium.headless}</selenium.headless>
                            </systemPropertyVariables>
                        </configuration>
                        <executions><execution><goals><goal>integration-test</goal><goal>verify</goal></goals></execution></executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-report-plugin</artifactId>
                        <version>3.5.6</version>
                        <configuration>
                            <outputDirectory>${project.build.directory}/selenium-report</outputDirectory>
                            <outputName>selenium</outputName>
                            <reportsDirectories><reportsDirectory>${selenium.reportsDirectory}</reportsDirectory></reportsDirectories>
                            <linkXRef>false</linkXRef>
                        </configuration>
                        <executions><execution><phase>verify</phase><goals><goal>failsafe-report-only</goal></goals></execution></executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
